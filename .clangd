CompileFlags:
    Add:
        [
            -Wno-unknown-attributes,
            -Wno-maybe-uninitialized,
            -Wno-unknown-warning-option,
            -Wno-pointer-to-int-cast,
            -Wno-int-to-void-pointer-cast,
            -DPROGMEM=,
            -xc,
            -std=gnu11,
            -D__GNUC__,
            '-DQMK_KEYBOARD_H=".build/obj_keychron_q11_ansi_encoder_two/src/default_keyboard.h"',
            '-DQMK_KEYBOARD="keychron/q11/ansi_encoder"',
            '-DQMK_KEYMAP="two"',
            '-DQMK_KEYMAP_H="two.h"',
            '-DQMK_KEYMAP_CONFIG_H="keyboards/keychron/q11/ansi_encoder/keymaps/two/config.h"',
            -DKEYBOARD_keychron_q11_ansi_encoder,
            -DPROTOCOL_CHIBIOS,
            -DMCU_STM32,
            -DSTM32L432xx,
            -Ikeyboards/keychron/q11/ansi_encoder/keymaps/two,
            -I.build/obj_keychron_q11_ansi_encoder_two/src,
            -I.,
            -Iquantum,
            -Itmk_core,
            -Idrivers,
            -Iquantum/keymap_extras,
            -Iquantum/process_keycode,
            -Iquantum/sequencer,
            -Idrivers/led,
            -Idrivers/eeprom,
            -Idrivers/wear_leveling,
            -Idrivers/encoder,
            -Iquantum/split_common,
            -Iquantum/nvm,
            -Iquantum/logging,
            -Iquantum/bootmagic,
            -Iquantum/send_string,
            -Iquantum/rgb_matrix,
            -Iquantum/rgb_matrix/animations,
            -Iquantum/rgb_matrix/animations/runners,
            -Iquantum/wear_leveling,
            -Iquantum/nvm/eeprom,
            -Ikeyboards/keychron/q11,
            -Ikeyboards/keychron/q11/ansi_encoder,
            -Ikeyboards/keychron,
            -Iplatforms,
            -Iplatforms/chibios,
            -Iplatforms/chibios/drivers,
            -Iplatforms/chibios/drivers/eeprom,
            -Iplatforms/chibios/drivers/wear_leveling,
            -Iplatforms/chibios/drivers/encoder,
            -Itmk_core/protocol,
            -Itmk_core/protocol/chibios,
            -Ilib/printf/src,
            -Ilib/printf/src/printf,
            -Ilib/fnv,
            -Ilib/chibios/os/rt/include,
            -Ilib/chibios/os/hal/include,
            -Ilib/chibios/os/common/portability/GCC,
            -Ilib/chibios/os/common/ports/ARM-common,
            -Ilib/chibios/os/common/ports/ARMv7-M,
            -Ilib/chibios/os/common/startup/ARMCMx/compilers/GCC,
            -Ilib/chibios/os/common/startup/ARMCMx/devices/STM32L4xx,
            -Ilib/chibios/os/common/ext/ARM/CMSIS/Core/Include,
            -Ilib/chibios/os/common/ext/ST/STM32L4xx,
            -Ilib/chibios/os/hal/osal/rt-nil,
            -Ilib/chibios/os/oslib/include,
            -Ilib/chibios/os/hal/ports/common/ARMCMx,
            -Ilib/chibios/os/hal/ports/STM32/STM32L4xx,
            -Ilib/chibios/os/hal/ports/STM32/LLD/GPIOv3,
            -Ilib/chibios/os/hal/ports/STM32/LLD/USARTv2,
            -Ilib/chibios/os/hal/ports/STM32/LLD/I2Cv2,
            -Ilib/chibios/os/hal/ports/STM32/LLD/SPIv2,
            -Ilib/chibios/os/hal/ports/STM32/LLD/TIMv1,
            -Ilib/chibios/os/hal/ports/STM32/LLD/USBv1,
            -Ilib/chibios/os/hal/ports/STM32/LLD/RCCv1,
            -Ilib/chibios/os/hal/ports/STM32/LLD/EXTIv1,
            -Ilib/chibios/os/hal/ports/STM32/LLD/SYSTICKv1,
            -Ilib/chibios/os/hal/ports/STM32/LLD/DMAv1,
            -Ilib/chibios/os/hal/ports/STM32/LLD/ADCv3,
            -Ilib/chibios/os/hal/ports/STM32/LLD/CANv1,
            -Ilib/chibios/os/hal/ports/STM32/LLD/DACv1,
            -Ilib/chibios/os/hal/ports/STM32/LLD/QUADSPIv1,
            -Ilib/chibios/os/hal/ports/STM32/LLD/RNGv1,
            -Ilib/chibios/os/hal/ports/STM32/LLD/RTCv2,
            -Ilib/chibios/os/hal/ports/STM32/LLD/SDMMCv1,
            -Ilib/chibios/os/hal/ports/STM32/LLD/USART,
            -Ilib/chibios/os/hal/ports/STM32/LLD/xWDGv1,
            -Ilib/chibios/os/hal/boards/ST_NUCLEO32_L432KC,
            -Ilib/chibios/os/hal/lib/streams,
            -Ilib/chibios/os/various,
            -Ilib/chibios/os/license,
            -Iplatforms/chibios/boards/GENERIC_STM32_L432XC/configs,
            -Iplatforms/chibios/boards/common/configs,
        ]
    Remove:
        [
            -W*,
            -Werror,
            -mmcu=*,
            -mcpu=*,
            -mfpu=*,
            -mfloat-abi=*,
            -mno-unaligned-access,
            -mno-thumb-interwork,
            -mcall-prologues,
            -D__has_include*,
            -mlra,
        ]
    Compiler: clang
Diagnostics:
    UnusedIncludes: None
    Suppress: "*"
